{
  "name": "scad-studio-tooling",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "web": "bun scripts/run_studio_web_dev.ts",
    "web:dev": "bun run --cwd packages/studio-web dev",
    "web:host": "bun scripts/run_websocket_host.ts",
    "web:build": "bun scripts/build_studio_web.ts",
    "web:smoke": "bun scripts/run_smoke.ts",
    "web:smoke:browser": "bun run --cwd packages/studio-web test:e2e",
    "protocol:build": "bun scripts/build_protocol_wasm.ts",
    "protocol:smoke": "bun scripts/smoke/protocol_package_smoke.ts",
    "protocol:check-generated": "bun scripts/check_protocol_wasm_generated.ts",
    "check:wasm-bindgen": "bun scripts/check_wasm_bindgen_version.ts"
  },
  "module": "index.ts",
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.12.27"
  }
}
